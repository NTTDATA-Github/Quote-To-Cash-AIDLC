# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.hypothesis/

# Local database (SQLite PoC)
portal_local.db
*.sqlite
*.sqlite3
*.db

# Corporate TLS-intercepting proxy root CA, exported locally so Docker builds can trust
# it (see Dockerfile.api/.worker/.odoo) — specific to this network, not portable, never
# committed.
.build-ca/

# Environment / secrets
.env
*.env
.cognito_demo.json
*_token.txt
*.tfvars

# IDE / tooling
.kiro/settings/
.playwright-mcp/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local process logs and pids (scripts/local.sh)
.local/

# Terraform provider binaries (keep .terraform.lock.hcl)
.terraform/
# Local CLI config so bootstrap can reuse the provider already on disk.
infra/azure/bootstrap/terraform.rc
# Bootstrap's state is local (chicken/egg: it creates the remote-state bucket itself).
infra/azure/bootstrap/terraform.tfstate*
# Terraform plan files embed resolved values; never commit them.
tfplan*
# Local crash-recovery dump Terraform writes after a failed state push — may contain
# real secrets in plaintext, never commit it.
errored.tfstate

# Temp
*.log
smoke_results.txt
smoke2.txt
ui_smoke.txt

# AWS Odoo POC: state and plans hold plaintext secrets
infra/aws-odoo-poc/terraform.tfstate*
infra/aws-odoo-poc/tfplan
