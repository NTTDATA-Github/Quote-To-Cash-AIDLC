        <mxCell id="flow_box" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;spacing=8;verticalAlign=middle;align=center;fillColor=#F7F9FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=11;spacing=12;fontColor=#333333;" value="&lt;b&gt;MAIN ORDER FLOW&lt;/b&gt; &lt;font style=&#39;font-size:10px&#39; color=&#39;#777777&#39;&gt;(follow the numbers on the arrows)&lt;/font&gt;&lt;br&gt;&lt;br&gt;① AdminOps calls the API (GraphQL over HTTPS) and lists every order and every reseller notification.&lt;br&gt;② The worker polls each bound customer&#39;s sale.order and appends OrderObserved plus an outbox row.&lt;br&gt;③ Worker&#39;s outbox relay publishes the event to the Service Bus topic.&lt;br&gt;④ Service Bus fans out (filtered) to per-consumer subscriptions (with DLQ).&lt;br&gt;⑤ Worker consumers project the order for AdminOps.&lt;br&gt;⑥ The same poll reads confirm, delivery, and invoice from Odoo.&lt;br&gt;⑦ Odoo can also push status to the API webhook route.&lt;br&gt;⑧ Worker delivers HMAC-signed status webhooks to the reseller. AdminOps lists those deliveries." vertex="1">
          <mxGeometry height="265" width="420" x="20" y="675" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
