VITE_GRAPHQL_URL=http://127.0.0.1:8000/graphql

# VITE_AUTH_PROVIDER picks the identity backend: "cognito" (default, AWS) or "keycloak"
# (Azure — see ADR-0023). Only the matching block below is read at runtime.
VITE_AUTH_PROVIDER=cognito

# /cognito-idp is a Vite dev-server proxy to floci (see vite.config.ts) — floci doesn't
# send CORS headers, so calling it directly from the browser fails. Leave this unset
# (or point it at nothing) when VITE_GRAPHQL_URL/prod targets real AWS Cognito, which
# supports CORS natively.
VITE_COGNITO_ENDPOINT_URL=/cognito-idp
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_53fbb00e8
VITE_COGNITO_CLIENT_ID=f538cd7a6dbe45d6a3978212cc

# Azure path (VITE_AUTH_PROVIDER=keycloak) — issuerUrl is infra/azure's
# `keycloak_realm_url` output; client id matches keycloak-realm-export.json's client.
VITE_KEYCLOAK_ISSUER_URL=https://o2c-staging-keycloak.calmgrass-bdb2a764.eastus.azurecontainerapps.io/realms/o2c
VITE_KEYCLOAK_CLIENT_ID=o2c-portal
