# Worker host — Service Bus consumers + outbox relay + reconcile scheduler.
# Identical build to Dockerfile.api; different CMD and no exposed port (the worker is a
# pure background process — no HTTP surface, so no HEALTHCHECK endpoint either).
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# ca-certificates provides update-ca-certificates, used below only when a
# corporate_ca secret is supplied.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./
# --mount=type=secret is a no-op unless the build passes
# --secret id=corporate_ca,src=<path>: BuildKit then mounts an EMPTY file at that path,
# so this is always safe in CI. It exists only to let a build behind a TLS-intercepting
# corporate proxy (see .gitignore's .build-ca/) trust that proxy's root CA before
# reaching PyPI — never required, never baked into the image.
RUN --mount=type=secret,id=corporate_ca,target=/usr/local/share/ca-certificates/corporate-ca.crt \
    if [ -s /usr/local/share/ca-certificates/corporate-ca.crt ]; then \
      update-ca-certificates && export PIP_CERT=/etc/ssl/certs/ca-certificates.crt; \
    fi && \
    pip install .

RUN useradd --create-home --uid 10001 appuser
USER appuser

# WORKER_ROLE=all runs consumers + relay + scheduler in one process (ADR-0010 role split
# lets this be narrowed later without an image change).
CMD ["python", "-m", "src.worker.main"]
