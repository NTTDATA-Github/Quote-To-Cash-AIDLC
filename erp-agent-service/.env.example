# Copy to .env (gitignored).
DATABASE_URL=sqlite:///./agent_runs.db
POLL_SECONDS=5
AGENT_TIMEOUT_SECONDS=1800

# The repo this service clones, works in, and opens PRs against — it manages its own
# clone, never assumes one is already sitting on disk (that's what makes this work in
# a container with nothing pre-existing, not just on a dev machine).
TARGET_REPO_URL=https://github.com/sridarsaikrishnan/AI-DLC-ERP-Supply-Chain-Order-Portal.git
REPO_CACHE_DIR=./repo-cache
WORKTREES_DIR=./worktrees

# A GitHub PAT (repo + pull_request scopes) or GitHub App installation token — used
# for git clone/fetch/push (injected per-command, never written to disk) AND picked
# up automatically by the gh CLI for `gh pr create` (no `gh auth login` needed).
GITHUB_TOKEN=

# Consumed by the `claude` CLI itself (invoked as a subprocess, not by this service's
# own Python code) — set it up the same way you'd set up `claude` interactively.
# Amazon Bedrock:
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
# ...or a direct Anthropic key:
# ANTHROPIC_API_KEY=

# Unpinned, Claude Code on Bedrock defaults to Opus — priced well above what a
# scoped, pattern-following coding task needs. Sonnet is the default here; override
# if you want Opus for something harder, or a different inference profile entirely.
CODING_AGENT_MODEL=us.anthropic.claude-sonnet-5

# Already set unconditionally in agent.py's subprocess call (see run_coding_agent) —
# listed here just for visibility, not required. On networks with a TLS-inspecting
# corporate proxy, Bedrock's streaming response content-type can get rewritten,
# which Claude Code otherwise rejects outright (confirmed on this network).
# CLAUDE_CODE_DISABLE_BEDROCK_CONTENT_TYPE_GUARD=1
